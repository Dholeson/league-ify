# --- league-ify configuration ---
# Copy this file to ".env" and fill it in. The server reads it on startup.

# Get a key from https://developer.riotgames.com/ (a Development key works to start;
# it expires every 24h. For a season-long grind, apply for a Personal API key.)
RIOT_API_KEY=

# Your Riot ID, split into game name and tag line.
# Example: for "Faker#KR1" -> RIOT_GAME_NAME=Faker, RIOT_TAG_LINE=KR1
RIOT_GAME_NAME=Dhole
RIOT_TAG_LINE=NA1

# Your platform: na1, euw1, eun1, kr, br1, la1, la2, oc1, tr1, ru, jp1, ...
RIOT_PLATFORM=na1

# Optional but recommended: enables the AI coach's reasoning engine. Without it,
# the coach still works using a deterministic fallback — with it, Claude reads
# your full data brief and reasons out your next-game plan.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: API server port (default 8787). Named SERVER_PORT (not PORT) so it
# won't collide with tools that inject PORT for the web dev server.
SERVER_PORT=8787
